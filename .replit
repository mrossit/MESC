modules = ["nodejs-20", "python-3.11", "web", "postgresql-16"]
run = "npm run build && npm run start"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]
[nix]
channel = "stable-24_05"
packages = ["gh", "google-cloud-sdk-gce", "imagemagick", "openssh", "parallel-full", "sqlite"]
[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]
[env]
PORT = "5000"
REPL_DISABLE_PACKAGE_CACHE = "1"
[workflows]
runButton = "Project"
[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"
[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"
[[workflows.workflow]]
name = "Start application"
author = "agent"
[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5050
externalPort = 3000

[[ports]]
localPort = 5077
externalPort = 3001

[[ports]]
localPort = 5078
externalPort = 3002
[agent]
